# ==============================================================================
# Mattermost ↔ Smartlead Enterprise Platform Environment Variables
# ==============================================================================

# Core Integration Credentials
SMARTLEAD_API_KEY=sl_prod_secret_key_12345
MATTERMOST_URL=http://localhost:8065
MATTERMOST_WS_URL=ws://localhost:8065
MATTERMOST_BOT_TOKEN=mm_bot_token_67890
MATTERMOST_VERIFICATION_TOKEN=mm_command_token_abcde

# Storage & Engine Backends
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_DATABASE=default
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
FLOWABLE_URL=http://localhost:8080/flowable-rest
FLOWABLE_USER=admin
FLOWABLE_PASSWORD=test
REDIS_URL=redis://localhost:6379/0

# Service Port Matrix
COMMAND_HANDLER_PORT=8000
SMARTLEAD_SYNC_PORT=8001
BOT_SERVICE_PORT=8002
ANALYTICS_PORT=8003
WORKFLOW_ENGINE_PORT=8004

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
LOG_LEVEL=INFO
PROMETHEUS_METRICS_ENABLED=true
